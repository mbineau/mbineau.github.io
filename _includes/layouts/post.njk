---
layout: layouts/base.njk
---
<article class="post">
  <header class="page-header">
    <p class="post-meta"><time datetime="{{ page.date | dateIso }}">{{ page.date | dateFr }}</time>
    {%- if tags %}{% for tag in tags %}{% if tag != "posts" %} <span class="tag">{{ tag }}</span>{% endif %}{% endfor %}{% endif %}</p>
    <h1>{{ title }}</h1>
    {% if description %}<p class="lead">{{ description }}</p>{% endif %}
  </header>
  <div class="prose">
    {{ content | safe }}
  </div>
  {% set previousPost = collections.posts | getPreviousCollectionItem %}
  {% set nextPost = collections.posts | getNextCollectionItem %}
  {% if previousPost or nextPost %}
  <nav class="post-nav" aria-label="Autres billets">
    {% if previousPost %}<a class="post-nav-prev" href="{{ previousPost.url }}">← {{ previousPost.data.title }}</a>{% endif %}
    {% if nextPost %}<a class="post-nav-next" href="{{ nextPost.url }}">{{ nextPost.data.title }} →</a>{% endif %}
  </nav>
  {% endif %}
  <p class="back-link"><a href="/blog/">← Tous les billets</a></p>
</article>
